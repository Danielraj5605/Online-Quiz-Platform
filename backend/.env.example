# Postgres (Neon pooled URL works for the app; use a direct URL for migrations if the pooler blocks them)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Optional: Redis for shared cache. Falls back to in-memory when unset.
REDIS_URL=
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
NODE_ENV=development
# Comma-separated allowed browser origins (required in production)
CORS_ORIGINS=http://localhost:5173
# Set true behind a reverse proxy so rate limits see the real client IP
TRUST_PROXY=false
